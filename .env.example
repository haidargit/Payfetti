# Optional. Defaults to the deployed address, the same on both networks.
VITE_PAYFETTI_ADDRESS=

# 5042 is mainnet, 5042002 is testnet.
VITE_CHAIN_ID=5042002

# Optional. Adds WalletConnect, for QR codes and mobile wallets. Free from
# https://dashboard.reown.com. Public by design, so restrict it with an allowlist.
VITE_WALLETCONNECT_PROJECT_ID=
