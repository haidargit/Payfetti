# Contract address. Defaults to the verified Arc testnet deployment.
VITE_PAYFETTI_ADDRESS=

# 5042002 is Arc testnet, 5042 is Arc mainnet.
VITE_CHAIN_ID=5042002

# Optional. Without it the wallet picker still finds every browser extension
# over EIP-6963 and offers Coinbase Wallet; with it, WalletConnect is added,
# which is what brings the QR code and mobile wallets.
#
# Free, from https://dashboard.reown.com (formerly WalletConnect Cloud). The id
# ships in the frontend bundle and is public by design, so restrict it with an
# allowlist in the dashboard rather than treating it as a secret. Localhost is
# always permitted, and allowlist changes take about 15 minutes to apply.
VITE_WALLETCONNECT_PROJECT_ID=
